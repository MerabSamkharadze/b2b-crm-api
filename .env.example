# ============================================================================
#  ლოკალური გარემო — ეს ფაილი .gitignore-შია და არასდროს უნდა აიტვირთოს git-ში.
# ============================================================================

NODE_ENV=development
PORT=3000

# ── PostgreSQL 16 (EDB installer, /Library/PostgreSQL/16)
# პაროლი შეგნებულად მხოლოდ hex სიმბოლოებისგან შედგება: ასე URL-ში
# percent-encoding არ გვჭირდება (@ # / ? სიმბოლოები URL-ს ჩუმად ამტვრევს).
DATABASE_URL="postgresql://crm_user:PASSWORD_HERE@localhost:5432/crm_db?schema=public"

# ── JWT — access და refresh ცალკე secret-ებით (compromise-ის blast radius მცირდება)
JWT_ACCESS_SECRET="გენერირება: openssl rand -hex 32"
JWT_REFRESH_SECRET="გენერირება: openssl rand -hex 32"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── bcrypt cost factor: რამდენჯერ გაორმაგდება hashing-ის სამუშაო (2^rounds).
# 10 = ~100ms ერთ hash-ზე თანამედროვე CPU-ზე — ეს არის მიზანი, არა bug.
BCRYPT_ROUNDS=10
